# Copy this file to .env and fill in the values
APP_MODE=development
APP_URL=http://localhost:8080

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=password
DB_NAME=codesign_test
DB_PORT=3306

# Mailer Configuration
MESSENGER_HOST=
MESSENGER_PORT=465
MESSENGER_NAME=
MESSENGER_MAIL=
MESSENGER_MAIL_PASSWORD=""

# Rate Limiter
RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX_REQUESTS=50
RATE_LIMITER_TIME_WINDOW=60

# Hashing
HASHING_IP_ALLOWLIST=127.0.0.1,::1
