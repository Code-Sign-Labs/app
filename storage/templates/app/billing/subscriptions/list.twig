{% extends "app/template.twig" %}

{% block page %}Subscriptions{% endblock %}

{% block content %}
    <main class="p-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Subscriptions</h2>
                <p class="text-sm text-gray-500 mt-1">Manage Stripe subscriptions directly from the panel.</p>
            </div>
        </div>

        {% if error %}
            <div class="bg-red-100 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                {{ error }}
            </div>
        {% endif %}
        {% if success %}
            <div class="bg-green-100 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                {{ success }}
            </div>
        {% endif %}

        <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <p class="text-sm font-medium text-gray-500">Total Subscriptions</p>
                <p class="text-2xl font-bold text-gray-900 mt-1">{{ subscriptions|length }}</p>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <table class="w-full">
                <thead>
                <tr class="border-b border-gray-200 bg-gray-50/50">
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Subscription</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Customer</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Product</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Amount</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Period</th>
                    <th class="px-5 py-3"></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for subscription in subscriptions %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-5 py-3">
                            <div class="text-sm font-medium text-gray-900">{{ subscription.id }}</div>
                            <div class="text-xs text-gray-500">{% if subscription.interval %}Every {{ subscription.interval }}{% endif %}</div>
                        </td>
                        <td class="px-5 py-3">
                            <div class="text-sm font-medium text-gray-900">{{ subscription.customer.name }}</div>
                            <div class="text-xs text-gray-500">{{ subscription.customer.email }}</div>
                        </td>
                        <td class="px-5 py-3 text-sm text-gray-700">{{ subscription.productName|default('—') }}</td>
                        <td class="px-5 py-3 text-sm text-gray-700">{% if subscription.priceAmountFormatted %}{{ subscription.priceAmountFormatted }} {{ subscription.currency|upper }}{% else %}—{% endif %}</td>
                        <td class="px-5 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium {% if subscription.status == 'active' %}bg-green-50 text-green-700{% elseif subscription.status == 'trialing' %}bg-blue-50 text-blue-700{% elseif subscription.status == 'past_due' %}bg-yellow-50 text-yellow-700{% elseif subscription.status == 'canceled' %}bg-red-50 text-red-700{% else %}bg-gray-50 text-gray-700{% endif %}">
                                {{ subscription.status|upper }}
                            </span>
                            {% if subscription.cancelAtPeriodEnd %}
                                <div class="text-xs text-yellow-600 mt-1">Cancels at period end</div>
                            {% endif %}
                        </td>
                        <td class="px-5 py-3 text-sm text-gray-700">
                            {% if subscription.canceledAt %}
                                <div>Canceled: {{ subscription.canceledAt }}</div>
                            {% else %}
                                <div>Start: {{ subscription.currentPeriodStart|default('—') }}</div>
                                <div>End: {{ subscription.currentPeriodEnd|default('—') }}</div>
                            {% endif %}
                        </td>
                        <td class="px-5 py-3">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/app/billing/subscriptions/{{ subscription.id }}" class="px-3 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Details</a>
                                {% if subscription.status != 'canceled' %}
                                    <form method="POST" action="/app/billing/subscriptions/{{ subscription.id }}/cancel" onsubmit="return confirm('Cancel this subscription in Stripe?');">
                                        <input type="hidden" name="__token" value="{{ csrf() }}">
                                        <button type="submit" class="px-3 py-2 text-sm font-medium text-red-700 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition">Cancel</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-5 py-10 text-center text-sm text-gray-500">No subscriptions found in Stripe.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}


