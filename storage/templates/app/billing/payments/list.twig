{% extends "app/template.twig" %}

{% block page %}Payments{% endblock %}

{% block content %}
    <main class="p-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Payments</h2>
                <p class="text-sm text-gray-500 mt-1">Stripe invoices and refunds handled directly from Code Sign.</p>
            </div>
        </div>

        {% if error %}
            <div class="bg-red-100 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">{{ error }}</div>
        {% endif %}
        {% if success %}
            <div class="bg-green-100 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">{{ success }}</div>
        {% endif %}

        <div class="grid grid-cols-3 gap-4 mb-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <p class="text-sm font-medium text-gray-500">Total Payments</p>
                <p class="text-2xl font-bold text-gray-900 mt-1">{{ payments|length }}</p>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <table class="w-full">
                <thead>
                <tr class="border-b border-gray-200 bg-gray-50/50">
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Payment</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Customer</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Subscription</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Amount</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
                    <th class="px-5 py-3"></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for payment in payments %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-5 py-3">
                            <div class="text-sm font-medium text-gray-900">{{ payment.number|default(payment.id) }}</div>
                            <div class="text-xs text-gray-500 font-mono">{{ payment.id }}</div>
                        </td>
                        <td class="px-5 py-3">
                            <div class="text-sm font-medium text-gray-900">{{ payment.customer.name }}</div>
                            <div class="text-xs text-gray-500">{{ payment.customer.email }}</div>
                        </td>
                        <td class="px-5 py-3 text-sm text-gray-700">
                            {% if payment.subscriptionId %}
                                <a class="text-brand hover:underline" href="/app/billing/subscriptions/{{ payment.subscriptionId }}">{{ payment.subscriptionId }}</a>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="px-5 py-3 text-sm text-gray-700">
                            {{ payment.amountPaidFormatted }} {{ payment.currency }}
                            {% if payment.amountRefunded > 0 %}
                                <div class="text-xs text-yellow-700">Refunded: {{ payment.amountRefundedFormatted }} {{ payment.currency }}</div>
                            {% endif %}
                        </td>
                        <td class="px-5 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium {% if payment.refunded %}bg-yellow-50 text-yellow-700{% else %}bg-green-50 text-green-700{% endif %}">
                                {{ payment.refunded ? 'REFUNDED' : payment.status|upper }}
                            </span>
                        </td>
                        <td class="px-5 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {% if payment.canRefund %}
                                    <form method="POST" action="/app/billing/payments/{{ payment.id }}/refund" onsubmit="return confirm('Refund this payment in Stripe?');">
                                        <input type="hidden" name="__token" value="{{ csrf() }}">
                                        <button type="submit" class="px-3 py-2 text-sm font-medium text-red-700 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition">Refund</button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-5 py-10 text-center text-sm text-gray-500">No payments found in Stripe.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}

