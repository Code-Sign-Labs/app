{% extends "app/template.twig" %}

{% block page %}Edit Customer{% endblock %}

{% block content %}
    <main class="p-8 max-w-3xl">
        <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900">Edit Customer</h2>
            <p class="text-sm text-gray-500 mt-1">Update the customer information below.</p>
        </div>

        {% if error %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                <strong class="font-bold">Error!</strong>
                <span class="block sm:inline">{{ error }}</span>
            </div>
        {% endif %}

        <form class="space-y-6" method="POST">
            <input type="hidden" name="__token" value="{{ csrf() }}">

            <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
                <h3 class="text-sm font-semibold text-gray-900">Information</h3>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email <span class="text-brand">*</span></label>
                        <input required type="email" id="email" name="email" value="{{ customer.email }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                    <div>
                        <label for="label" class="block text-sm font-medium text-gray-700 mb-1.5">Label <span class="text-brand">*</span></label>
                        <input required type="text" id="label" name="label" value="{{ customer.label }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1.5">Address <span class="text-brand">*</span></label>
                        <input required type="text" id="address" name="address" value="{{ customer.address }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                    <div>
                        <label for="country" class="block text-sm font-medium text-gray-700 mb-1.5">Country <span class="text-brand">*</span></label>
                        <input required type="text" id="country" name="country" value="{{ customer.country }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="postal_code" class="block text-sm font-medium text-gray-700 mb-1.5">Postal Code <span class="text-brand">*</span></label>
                        <input required type="text" id="postal_code" name="postal_code" value="{{ customer.postalCode }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                    <div>
                        <label for="currency" class="block text-sm font-medium text-gray-700 mb-1.5">Currency <span class="text-brand">*</span></label>
                        <input required type="text" id="currency" name="currency" value="{{ customer.currency }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="city" class="block text-sm font-medium text-gray-700 mb-1.5">City <span class="text-brand">*</span></label>
                        <input required type="text" id="city" name="city" value="{{ customer.city }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                    <div>
                        <label for="vat_number" class="block text-sm font-medium text-gray-700 mb-1.5">VAT Number</label>
                        <input type="text" id="vat_number" name="vat_number" value="{{ customer.vatNumber }}" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                    </div>
                </div>

                <div>
                    <label for="notes" class="block text-sm font-medium text-gray-700 mb-1.5">Notes</label>
                    <textarea id="notes" name="notes" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">{{ customer.notes }}</textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3">
                <a href="/app/billing/customers/{{ customer.id }}" class="px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Cancel</a>
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-brand hover:bg-brand-hover rounded-lg transition shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Save Changes
                </button>
            </div>
        </form>
    </main>
{% endblock %}
