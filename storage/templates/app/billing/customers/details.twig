{% extends "app/template.twig" %}

{% block page %}Customer Details{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Header -->
        <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-full bg-blue-500 text-white flex items-center justify-center text-xl font-bold">{{ customer.label|slice(0, 2)|upper }}</div>
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-xl font-bold text-gray-900">{{ customer.label }}</h2>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">{{ customer.email }}</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/app/billing/customers/{{ customer.id }}/edit" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Edit
                </a>
                <a href="/app/billing/customers/{{ customer.id }}/delete" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                    Delete
                </a>
            </div>
        </div>
        {% if error %}
            <div class="bg-red-100 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                {{ error }}
            </div>
        {% endif %}
        {% if success %}
            <div class="bg-green-100 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
                {{ success }}
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Details & Activity -->
            <div class="lg:col-span-2 space-y-6">
                <!-- User Info -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Customer Information</h3>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Full Name</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.label }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Email</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Address</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.address }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">City</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.city }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Country</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.country }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Postal Code</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.postalCode }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Currency</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.currency }}</p>
                        </div>
                        {% if customer.vatNumber %}
                            <div>
                                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">VAT Number</p>
                                <p class="text-sm text-gray-900 mt-1">{{ customer.vatNumber }}</p>
                            </div>
                        {% endif %}
                        {% if customer.notes %}
                            <div>
                                <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Notes</p>
                                <p class="text-sm text-gray-900 mt-1">{{ customer.notes }}</p>
                            </div>
                        {% endif %}
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Metadata</p>
                            <code><p class="text-sm text-gray-900 mt-1 code">{{ customer.metadata|json_encode }}</p></code>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Stripe Customer Id</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.stripeCustomerId }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Created At</p>
                            <p class="text-sm text-gray-900 mt-1">{{ customer.createdAt|date("d M, Y") }}</p>
                        </div>
                    </div>
                </div>


                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Subscriptions</h3>
                    <div class="grid grid-cols-1">
                        {% for subscription in subscriptions %}
                            {% set details = subscription.items.data[0] %}
                            <div>
                                <div class="flex items-center justify-between cursor-pointer hover:bg-gray-50 p-4 rounded-xl" onclick="window.location.href='/app/billing/subscriptions/{{ subscription.id }}'">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Subscription #{{ subscription.id }}</p>
                                        <p class="text-xs text-gray-500 mt-1">Status: {{ subscription.status }} | Product: <a class="hover:text-brand" href="/app/products/{{ products[subscription.plan.product].slug}}">{{ products[subscription.plan.product].name}}</a>
                                        </p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-gray-900">{{ details.price.unit_amount / 100 }} {{ details.price.currency|upper }}</p>
                                        <p class="text-xs text-gray-500 mt-1">Next Billing: {{ details.current_period_end|date("d M, Y") }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">License Keys</h3>
                    <div class="grid grid-cols-1">
                        {% for license in licenses %}
                            <div>
                                <div class="flex items-center justify-between cursor-pointer hover:bg-gray-50 p-4 rounded-xl" onclick="window.location.href='/app/licenses/{{ license.id }}'">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">License #{{ license.id }}</p>
                                        <p class="text-xs text-gray-500 mt-1">Status: {{ license.status.value|capitalize }} | Type: {{ license.type.value|capitalize }}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-gray-900">{{ license.key }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}