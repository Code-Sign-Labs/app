{% extends "app/template.twig" %}

{% block page %}Certificates{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Certificates</h2>
                <p class="text-sm text-gray-500 mt-1">Manage the key pair used to sign and verify license tokens.</p>
            </div>
            <button onclick="document.getElementById('rotateModal').classList.remove('hidden')" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-brand hover:bg-brand-hover rounded-lg transition shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Rotate Certificates
            </button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Public Certificate -->
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-gray-50/50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-900">Public key</h3>
                            <p class="text-xs text-gray-500">Safe to share with clients</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="copyToClipboard('publicCert')" class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            Copy
                        </button>
                        <button onclick="downloadCert('public')" class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        Download
                        </button>
                    </div>
                </div>
                <div class="p-6 space-y-4">
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Fingerprint</p>
                            <p class="text-xs font-mono text-gray-900 mt-1 break-all">{{ fingerprint_public }}</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Public Key</p>
                        <div class="bg-gray-900 rounded-lg p-4 max-h-48 overflow-auto">
                <pre id="publicCert" class="text-xs font-mono text-green-400 whitespace-pre-wrap break-all">{{ public_key_pem }}</pre>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Private Certificate -->
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-gray-50/50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-yellow-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-900">Private Key</h3>
                            <p class="text-xs text-gray-500">Keep secret, don't share</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button id="togglePrivate" onclick="togglePrivateKey()" class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            <span id="togglePrivateLabel">Reveal</span>
                        </button>
                        <button onclick="downloadCert('private')" class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                            Download
                        </button>
                    </div>
                </div>
                <div class="p-6 space-y-4">
                    <div class="flex items-start gap-3 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <svg class="w-4 h-4 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <p class="text-xs text-red-700">Anyone with this key can forge valid license tokens. Do not expose it publicly.</p>
                    </div>
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Fingerprint</p>
                            <p class="text-xs font-mono text-gray-900 mt-1 break-all">{{ fingerprint_private }}</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Private Key</p>
                        <div class="bg-gray-900 rounded-lg p-4 max-h-48 overflow-auto">
                <pre id="privateCert" class="text-xs font-mono text-gray-500 whitespace-pre-wrap break-all">-----BEGIN ENCRYPTED PRIVATE KEY-----
████████████████████████████████████████████████████████████
████████████████████████████████████████████████████████████
████████████████████████████████████████████████████████████
████████████████████████████████████████████████████████████
████████████████████████████████████████████████████████████
-----END ENCRYPTED PRIVATE KEY-----</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Rotate Modal -->
    <div id="rotateModal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/50" onclick="document.getElementById('rotateModal').classList.add('hidden')"></div>
        <form id="rotateCert" class="relative bg-white rounded-xl shadow-xl w-full max-w-md mx-4" method="POST">
            <input type="hidden" name="__token" value="{{ csrf() }}">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-900">Rotate Certificates</h3>
                <button onclick="document.getElementById('rotateModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="px-6 py-5 space-y-4">
                <div class="flex items-start gap-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <svg class="w-5 h-5 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <div>
                        <p class="text-sm font-medium text-yellow-900">This action is irreversible</p>
                        <p class="text-xs text-yellow-700 mt-1">Rotating the key pair will generate a new RSA-4096 key pair. All existing license tokens signed with the old key will no longer verify. Clients must update to the new public key.</p>
                    </div>
                </div>
                <div>
                    <label for="confirmText" class="block text-sm font-medium text-gray-700 mb-2">Type <span class="font-mono text-brand">ROTATE</span> to confirm</label>
                    <input type="text" id="confirmText" placeholder="ROTATE" class="w-full px-3.5 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition font-mono">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-end gap-3">
                <button type="button" onclick="document.getElementById('rotateModal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition">Cancel</button>
                <button type="button" id="rotateBtn" disabled onclick="confirmRotate()" class="px-4 py-2 text-sm font-semibold text-white bg-gray-300 rounded-lg cursor-not-allowed transition">Rotate Now</button>
            </div>
        </form>
    </div>

    <!-- Toast -->
    <div id="toast" class="hidden fixed bottom-6 right-6 z-50">
        <div class="flex items-center gap-3 px-4 py-3 bg-gray-900 text-white rounded-lg shadow-lg">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span id="toastMessage" class="text-sm font-medium">Copied to clipboard</span>
        </div>
    </div>

    <script>
        // Copy to clipboard
        function copyToClipboard(elementId) {
            const text = document.getElementById(elementId).textContent;
            navigator.clipboard.writeText(text).then(() => {
                showToast('Public certificate copied to clipboard');
            }).catch(() => {
                showToast('Failed to copy');
            });
        }

        // Toggle private key visibility
        let _privateRevealed = false;
        function togglePrivateKey() {
            const cert = document.getElementById('privateCert');
            const label = document.getElementById('togglePrivateLabel');
            if (!_privateRevealed) {
                cert.classList.remove('text-gray-500');
                cert.classList.add('text-yellow-400');
                cert.innerHTML = `{{ private_key_pem }}`;
                label.textContent = 'Hide';
                _privateRevealed = true;
            } else {
                cert.classList.add('text-gray-500');
                cert.classList.remove('text-yellow-400');
                cert.innerHTML = '-----BEGIN ENCRYPTED PRIVATE KEY-----\n████████████████████████████████████████████████████████████\n████████████████████████████████████████████████████████████\n████████████████████████████████████████ ████████\n-----END ENCRYPTED PRIVATE KEY-----';
                label.textContent = 'Reveal';
                _privateRevealed = false;
            }
        }

        // Download cert
        function downloadCert(type) {
            showToast(type === 'public' ? 'Downloading public certificate...' : 'Downloading private key...');

            if(type === 'public') {
                const blob = new Blob([`{{ public_key_pem }}`], { type: 'application/x-pem-file' });
                const url = URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = 'public_cert.pem';
                a.click();

                url.revokeObjectURL(url);
            } else {
                const blob = new Blob([`{{ private_key_pem }}`], { type: 'application/x-pem-file' });
                const url = URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = 'private_key.pem';
                a.click();

                url.revokeObjectURL(url);
            }
        }

        // Toast
        let _toastTimer;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(_toastTimer);
            _toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        // Confirm rotation
        const confirmInput = document.getElementById('confirmText');
        const rotateBtn = document.getElementById('rotateBtn');
        confirmInput.addEventListener('input', function() {
            if (this.value === 'ROTATE') {
                rotateBtn.disabled = false;
                rotateBtn.classList.remove('bg-gray-300', 'cursor-not-allowed');
                rotateBtn.classList.add('bg-brand', 'hover:bg-brand-hover', 'cursor-pointer');
            } else {
                rotateBtn.disabled = true;
                rotateBtn.classList.add('bg-gray-300', 'cursor-not-allowed');
                rotateBtn.classList.remove('bg-brand', 'hover:bg-brand-hover', 'cursor-pointer');
            }
        });

        function confirmRotate() {
            document.getElementById('rotateModal').classList.add('hidden');
            showToast('Certificates rotated successfully');
            const rotateCert = document.getElementById('rotateCert');
            rotateCert.submit();
        }

        // User menu click-outside
        document.addEventListener('click', function(e) {
            const menu = document.getElementById('userMenu');
            const trigger = e.target.closest('.cursor-pointer');
            if (menu && !menu.contains(e.target) && !trigger?.contains(e.target)) {
                menu.classList.add('hidden');
            }
        });
    </script>
{% endblock %}