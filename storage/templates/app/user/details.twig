{% extends "app/template.twig" %}

{% block page %}User Details{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Header -->
        <div class="flex items-start justify-between mb-6">
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-full bg-blue-500 text-white flex items-center justify-center text-xl font-bold">{{ userTarget.name|slice(0, 2)|upper }}</div>
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-xl font-bold text-gray-900">{{ userTarget.name }}</h2>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">{{ userTarget.email }}</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a href="/app/users/{{ userTarget.id }}/edit" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Edit Profile
                </a>
                <a href="/app/users/{{ userTarget.id }}/delete" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                    Delete
                </a>
            </div>
        </div>
        {% if error %}
            <div class="bg-red-100 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                {{ error }}
            </div>
        {% endif %}
        {% if success %}
            <div class="bg-green-100 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
                {{ success }}
            </div>
        {% endif %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Details & Activity -->
            <div class="lg:col-span-2 space-y-6">
                <!-- User Info -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Account Information</h3>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Full Name</p>
                            <p class="text-sm text-gray-900 mt-1">{{ userTarget.name }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Email</p>
                            <p class="text-sm text-gray-900 mt-1">{{ userTarget.email }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Created At</p>
                            <p class="text-sm text-gray-900 mt-1">{{ userTarget.createdAt|date("d M, Y") }}</p>
                        </div>
                    </div>
                </div>

                <!-- Activity Log -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Recent Activity</h3>
                    <div class="space-y-4">
                        {% for log in logs|slice(0,5) %}
                            <div class="flex gap-3">
                                {% set type = log.event|split('.')|last %}
                                <div class="w-2 h-2 rounded-full {% if type == "success"%}bg-green-500{% elseif type == "failure" %}bg-red-500{% else%}bg-gray-400{% endif%} mt-1.5 flex-shrink-0"></div>
                                <div>
                                    <p class="text-sm text-gray-700">{{ log.description }}</p>
                                    <p class="text-xs text-gray-400">{{ log.createdAt|date("M j, Y · g:i A") }}</p>
                                    <a {% if log.user %}href="/app/users/{{ log.user.id }}"{% endif %} class="text-xs text-gray-400 mt-0.5">{{ log.user ? log.user.email : "SYSTEM" }}</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}