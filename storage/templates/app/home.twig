{% extends "app/template.twig" %}

{% block page %}Dashboard{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Welcome -->
        <div class="mb-8">
            <h2 class="text-xl font-bold text-gray-900">Welcome back, {{ user.name }}</h2>
            <p class="text-sm text-gray-500 mt-1">Here's what's happening with your licensing system today.</p>
        </div>

        <!-- Stat cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-gray-500">Total Licenses</span>
                    <div class="w-8 h-8 rounded-lg bg-brand-light flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900">{{ license_count }}</p>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-gray-500">Active Products</span>
                    <div class="w-8 h-8 rounded-lg bg-brand-light flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900">{{ products_count }}</p>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-gray-500">Total Users</span>
                    <div class="w-8 h-8 rounded-lg bg-brand-light flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900">{{ users_count }}</p>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-gray-500">Activations</span>
                    <div class="w-8 h-8 rounded-lg bg-brand-light flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M3.5 18a2.5 3 0 1 0 5 0a2.5 3 0 1 0 -5 0" />
                            <path d="M2 18h1.5" />
                            <path d="M8.5 18h1.5" />
                            <path d="M9.5 14.5l-1.5 1.5" />
                            <path d="M2.5 14.5l1.5 1.5" />
                            <path d="M2.5 21.5l1.5 -1.5" />
                            <path d="M8 20l1.5 1.5" />
                            <path d="M13 16l8 -5l-13 -8v8" />
                        </svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900">{{ activation_count }}</p>
            </div>
        </div>

        <!-- Two column -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Recent licenses -->
            <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
                    <h3 class="text-sm font-semibold text-gray-900">Recent Licenses</h3>
                    <a href="/app/licenses" class="text-xs font-medium text-brand hover:text-brand-hover transition">View all</a>
                </div>
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-100">
                            <th class="text-left px-5 py-2.5 text-xs font-medium text-gray-500 uppercase tracking-wide">Id<th>
                            <th class="text-left px-5 py-2.5 text-xs font-medium text-gray-500 uppercase tracking-wide">Product</th>
                            <th class="text-left px-5 py-2.5 text-xs font-medium text-gray-500 uppercase tracking-wide">Created At</th>
                            <th class="text-left px-5 py-2.5 text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for license in licenses %}
                            <tr class="hover:bg-gray-50 cursor-pointer transition" onclick="window.location.href='/app/licenses/{{ license.id }}'">
                                <td class="px-5 py-3 text-sm font-mono text-gray-700">{{ license.id }}</td>
                                <td></td>
                                <td class="px-5 py-3 text-sm text-gray-700">{{ license.product.name }}</td>
                                <td class="px-5 py-3 text-sm text-gray-500">{{ license.createdAt|date("Y-m-d H:i:s") }}</td>
                                <td class="px-5 py-3">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium {% if license.status.value == "active" %}bg-green-50 text-green-700{% elseif license.status.value == "revoked" %}bg-yellow-50 text-yellow-700{% else %}bg-red-50 text-red-700{% endif %}">{{ license.status.value|upper }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Activity feed -->
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-200">
                    <h3 class="text-sm font-semibold text-gray-900">Recent Activity</h3>
                </div>
                <div class="p-5 space-y-4">
                    {% for audit_log in audit_logs %}
                    <div class="flex gap-3">
                        {% set type = audit_log.event|split('.')|last %}
                        <div class="w-2 h-2 rounded-full {% if type == "success"%}bg-green-500{% elseif type == "failure" %}bg-red-500{% else%}bg-gray-400{% endif%} mt-1.5 flex-shrink-0"></div>
                        <div>
                            <p class="text-sm text-gray-700">{{ audit_log.description|shorten(100) }}</p>
                            <p class="text-xs text-gray-400 mt-0.5">{{ time_ago(audit_log.createdAt) }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="/app/license-new" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand hover:shadow-sm transition group">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center group-hover:bg-brand group-hover:text-white transition">
                        <svg class="w-5 h-5 text-brand group-hover:text-white transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">Create License</p>
                        <p class="text-xs text-gray-500">Issue a new license key</p>
                    </div>
                </div>
            </a>
            <a href="/app/product-new" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand hover:shadow-sm transition group">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center group-hover:bg-brand group-hover:text-white transition">
                        <svg class="w-5 h-5 text-brand group-hover:text-white transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">Add Product</p>
                        <p class="text-xs text-gray-500">Register a new product</p>
                    </div>
                </div>
            </a>
            <a href="/app/user-new" class="bg-white rounded-xl border border-gray-200 p-5 hover:border-brand hover:shadow-sm transition group">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-brand-light flex items-center justify-center group-hover:bg-brand group-hover:text-white transition">
                        <svg class="w-5 h-5 text-brand group-hover:text-white transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-900">Add User</p>
                        <p class="text-xs text-gray-500">Add a team member</p>
                    </div>
                </div>
            </a>
        </div>
    </main>
{% endblock %}