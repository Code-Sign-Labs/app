{% extends "app/template.twig" %}

{% block page %}License Details{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Header -->
        <div class="flex items-start justify-between mb-6">
            <div>
                <div class="flex items-center gap-3 mb-1">
                    <h2 class="text-xl font-bold text-gray-900 font-mono">{{ license.key }}</h2>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium {% if license.status.value == "active" %}bg-green-50 text-green-700{% elseif license.status.value == "revoked" %}bg-yellow-50 text-yellow-700{% else %}bg-red-50 text-red-700{% endif %}">{{ license.status.value|capitalize }}</span>
                </div>
                <p class="text-sm text-gray-500">Perpetual license for <a href="/app/products/{{ license.product.slug }}" class="text-brand hover:text-brand-hover font-medium">{{ license.product.name }}</a></p>
            </div>
            <div class="flex items-center gap-2">
                <a href="/app/licenses/{{ license.id }}/suspend" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-yellow-700 bg-yellow-50 hover:bg-yellow-100 border border-yellow-200 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ license.status.value == "suspend" ? "Unsuspend" : "Suspend" }}
                </a>
                <a href="/app/licenses/{{ license.id }}/revoke" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    {{ license.status.value == "revoked" ? "Unrevoke" : "Revoke" }}
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Details -->
            <div class="lg:col-span-2 space-y-6">
                <!-- License Info -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">License Information</h3>
                    <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">License Key</p>
                            <p class="text-sm font-mono text-gray-900 mt-1">{{ license.key }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Type</p>
                            <p class="text-sm text-gray-900 mt-1">{{ license.type.value|capitalize }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Product</p>
                            <p class="text-sm text-gray-900 mt-1"><a href="/app/products/{{ license.product.slug }}" class="text-brand hover:text-brand-hover">{{ license.product.name }}</a></p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Status</p>
                            <p class="mt-1"><span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium {% if license.status.value == "active" %}bg-green-50 text-green-700{% elseif license.status.value == "revoked" %}bg-yellow-50 text-yellow-700{% else %}bg-red-50 text-red-700{% endif %}">{{ license.status.value|capitalize }}</span></p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Created</p>
                            <p class="text-sm text-gray-900 mt-1">{{ license.createdAt|date('M j, Y, g:i A') }}</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Expiration</p>
                            <p class="text-sm text-gray-900 mt-1">{{ license.expiresAt ? license.expiresAt|date('M j, Y, g:i A') : "Never" }}</p>
                        </div>
                    </div>
                </div>

                <!-- Activations -->
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                        <h3 class="text-sm font-semibold text-gray-900">Activations</h3>
                        <span class="text-sm text-gray-500">{{ license.currentActivations }} of {{ license.maxActivations}} used</span>
                    </div>
                    <div class="p-6 space-y-3">
                        {% for activation in activations %}
                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-white border border-gray-200 flex items-center justify-center">
                                        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">{{ activation.deviceName }}</p>
                                        <p class="text-xs text-gray-500">{{ activation.active ? "Active" : "Inactive" }} · {{ activation.deviceIdentifier }} · {{ activation.ipAddress }}</p>
                                    </div>
                                </div>
                                <span class="text-xs text-gray-400">{{ activation.createdAt|date("M j, Y · g:i A") }} {% if activation.deactivatedAt %}- {{ activation.deactivatedAt|date("M j, Y · g:i A") }}{% endif %}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Right: Entitlements & Timeline -->
            <div class="space-y-6">

                <!-- Timeline -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-sm font-semibold text-gray-900 mb-4">Activity Timeline</h3>
                    <div class="space-y-4">
                        {% for log in logs %}
                            <div class="flex gap-3">
                                {% set type = log.event|split('.')|last %}
                                <div class="w-2 h-2 rounded-full {% if type == "success"%}bg-green-500{% elseif type == "failure" %}bg-red-500{% else%}bg-gray-400{% endif%} mt-1.5 flex-shrink-0"></div>
                                <div>
                                    <p class="text-sm text-gray-700">{{ log.description }}</p>
                                    <p class="text-xs text-gray-400">{{ log.createdAt|date("M j, Y · g:i A") }}</p>
                                    <a {% if log.user %}href="/app/users/{{ log.user.id }}"{% endif %} class="text-xs text-gray-400 mt-0.5">{{ log.user ? log.user.email : "SYSTEM" }}</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}