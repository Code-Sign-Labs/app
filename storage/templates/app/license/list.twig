{% extends "app/template.twig" %}

{% block page %}License list{% endblock %}

{% block content %}
    <main class="p-8">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Licenses</h2>
                <p class="text-sm text-gray-500 mt-1">Manage and monitor all license keys across your products.</p>
            </div>
            <a href="/app/license-new" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-brand hover:bg-brand-hover rounded-lg transition shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                New License
            </a>
        </div>

        <!-- Success Alert -->
        {% if success %}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4" role="alert">
            <strong class="font-bold">Success! </strong>
            <span class="block sm:inline">{{ success }}</span>
        </div>
        {% endif %}

        <!-- Filters -->
        <form class="bg-white rounded-xl border border-gray-200 p-4 mb-4 flex flex-wrap items-center gap-3" method="get" action="/app/licenses">
            <select class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand bg-white" name="product">
                <option value="all" {% if filters.product == "all" %}selected{% endif %}>All Products</option>
                {% for product in products %}
                    <option value="{{ product.slug }}" {% if filters.product == product.slug %}selected{% endif %}>{{ product.name }}</option>
                {% endfor %}
            </select>
            <select class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand bg-white" name="status">
                <option value="all" {% if filters.status == "all" %}selected{% endif %}>All Status</option>
                <option value="active" {% if filters.status == "active" %}selected{% endif %}>Active</option>
                <option value="suspended" {% if filters.status == "suspended" %}selected{% endif %}>Suspended</option>
                <option value="expired" {% if filters.status == "expired" %}selected{% endif %}>Expired</option>
                <option value="revoked" {% if filters.status == "revoked" %}selected{% endif %}>Revoked</option>
            </select>
            <select class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand bg-white" name="type">
                <option value="all" {% if filters.type == "all" %}selected{% endif %}>All Types</option>
                <option value="perpetual" {% if filters.type == "perpetual" %}selected{% endif %}>Perpetual</option>
                <option value="subscription" {% if filters.type == "subscription" %}selected{% endif %}>Subscription</option>
                <option value="trial" {% if filters.type == "trial" %}selected{% endif %}>Trial</option>
            </select>
            <select class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand bg-white" name="batch">
                <option value="all" {% if filters.batch == "all" %}selected{% endif %}>All batches</option>
                {% for batch in batches %}
                    <option value="{{ batch.id }}" {% if filters.batch == batch.id %}selected{% endif %}>{{ batch.label }}</option>
                {% endfor %}
            </select>
            <div class="ml-auto flex items-center gap-2">
                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" />
                    </svg>
                    Filter
                </button>
            </div>
        </form>

        <!-- Table -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <table class="w-full">
                <thead>
                <tr class="border-b border-gray-200 bg-gray-50/50">
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Id</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">License Key</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Product</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Type</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Max Activations</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Activations</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Created</th>
                    <th class="text-left px-5 py-3 text-xs font-medium text-gray-500 uppercase tracking-wide">Expires At</th>
                    <th class="px-5 py-3"></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for license in licenses %}
                        <tr class="hover:bg-gray-50 transition cursor-pointer" onclick="window.location.href='/app/licenses/{{ license.id }}'">
                            <td class="px-5 py-3 text-sm font-mono text-gray-700">{{ license.id }}</td>
                            <td class="px-5 py-3 text-sm text-gray-700">{{ license.key }}</td>
                            <td class="px-5 py-3 text-sm text-gray-500">{{ license.product.name }}</td>
                            <td class="px-5 py-3"><span class="text-xs text-gray-600 bg-gray-100 px-2 py-0.5 rounded">{{ license.type.value|capitalize }}</span></td>
                            <td class="px-5 py-3 text-sm text-gray-600">{{ license.maxActivations }}</td>
                            <td class="px-5 py-3 text-sm text-gray-600">{{ license.currentActivations }}</td>
                            <td class="px-5 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium {% if license.status.value == "active" %}bg-green-50 text-green-700{% elseif license.status.value == "revoked" %}bg-yellow-50 text-yellow-700{% else %}bg-red-50 text-red-700{% endif %}">{{ license.status.value|upper }}</span></td>
                            <td class="px-5 py-3 text-sm text-gray-500">{{ license.createdAt|date('M j, Y') }}</td>
                            <td class="px-5 py-3 text-sm text-gray-500">{{ license.expiresAt ? license.expiresAt|date('M j, Y') : 'Never' }}</td>
                            <td class="px-5 py-3 text-right"><svg class="w-4 h-4 text-gray-400 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 0 010 2z"/></svg></td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="px-5 py-8 text-center text-sm text-gray-500" colspan="10">No licenses found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="flex flex-col gap-3 px-5 py-3 border-t border-gray-200 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm text-gray-500">
                    {% if pagination.totalItems > 0 %}
                        Showing {{ pagination.from }}-{{ pagination.to }} of {{ pagination.totalItems }} licenses
                    {% else %}
                        No licenses to show
                    {% endif %}
                </p>
                {% if pagination.pages %}
                    <div class="flex items-center gap-1">
                        {% if pagination.previousUrl %}
                            <a href="{{ pagination.previousUrl }}" class="px-3 py-1.5 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">Previous</a>
                        {% else %}
                            <span class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-200 rounded-lg bg-gray-50 cursor-not-allowed">Previous</span>
                        {% endif %}

                        {% for page in pagination.pages %}
                            {% if page.type == 'ellipsis' %}
                                <span class="px-2 text-sm text-gray-400">...</span>
                            {% elseif page.active %}
                                <span class="px-3 py-1.5 text-sm font-medium text-white bg-brand border border-brand rounded-lg">{{ page.number }}</span>
                            {% else %}
                                <a href="{{ page.url }}" class="px-3 py-1.5 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">{{ page.number }}</a>
                            {% endif %}
                        {% endfor %}

                        {% if pagination.nextUrl %}
                            <a href="{{ pagination.nextUrl }}" class="px-3 py-1.5 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">Next</a>
                        {% else %}
                            <span class="px-3 py-1.5 text-sm font-medium text-gray-400 border border-gray-200 rounded-lg bg-gray-50 cursor-not-allowed">Next</span>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
