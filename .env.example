# Copy this file to .env and fill in the values
APP_MODE=production
APP_URL=http://localhost:8080

# Mailer Configuration
MESSENGER_HOST=
MESSENGER_PORT=465
MESSENGER_NAME=
MESSENGER_MAIL=
MESSENGER_MAIL_PASSWORD=""

# Rate Limiter
RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX_REQUESTS=50
RATE_LIMITER_TIME_WINDOW=60